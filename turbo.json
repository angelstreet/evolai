{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "public/**", "next.config.*", "tsconfig.json", "package.json"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}",
        ".eslintrc*",
        "eslint.config.*",
        "tsconfig*.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL"],
      "inputs": ["src/**", "tests/**", "vitest.config.*", "tsconfig*.json", "package.json"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false,
      "outputs": ["dist/**", ".next/**", "coverage/**"]
    }
  }
}
